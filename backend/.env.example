# ==========================================
# RecycleVision AI - Backend Environment Variables
# ==========================================

# Model Configuration
MODEL_PATH=backend/models/best_model.h5
MAX_UPLOAD_MB=10

# CORS Allowed Origins (Comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://recyclevision-ai.vercel.app

# Supabase Database & Auth (Optional - falls back to local SQLite if omitted)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication Secret (Used for role checks and admin dashboard access)
ADMIN_SECRET_KEY=recyclevision-admin-dev-secret-key-2026

# OpenAI ChatGPT Integration (Enables ChatGPT Vision Omni-Mode & RecycleBot Chat)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Local SQLite Storage Path (Fallback when Supabase is not configured)
SQLITE_DB_PATH=backend/data/recyclevision.db
REPORTS_DIR=backend/reports
